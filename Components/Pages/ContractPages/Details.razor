@page "/contracts/details"
@using Microsoft.EntityFrameworkCore
@using BlazorAppAttempt.Models
@inject IDbContextFactory<BlazorAppAttempt.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@using System.Globalization;

<PageTitle>Details</PageTitle>

<head>
    <!-- Add this in your HTML head section -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
</head>

<div class="container mt-4">
    <h1 class="text-center">Contract Details</h1>
    <hr />

    @if (isLoading)
    {
        <div class="text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (contract is null)
    {
        <p class="loading-text"><em>Contract not found.</em></p>
    }
    else
    {
        <div class="row">
            <div class="col-md-4">
                <div class="card mb-4">
                    <div class="card-body">
                        <h4 class="card-title">@contract.Subcontractor?.Name</h4>
                        <p class="card-text"><strong>Contract Amount:</strong> @contract.Amount.ToString("C", crCulture) (@ContractAmountUSDString)</p>

                        @if (contract.ChangeOrders != null && contract.ChangeOrders.Any())
                        {
                            <p class="card-text"><strong>Extra Amount:</strong> @ChangeOrdersTotal.ToString("C", crCulture)</p>
                        }
                        <p class="card-text"><strong>Contract Details:</strong> @contract.OtherContractDetails</p>
                        <p class="card-text"><strong>Project:</strong> @contract.Project?.ProjectName</p>
                        <div class="progress mb-3">
                            <div class="progress-bar" role="progressbar" style="width:@contract.Progress%" aria-valuenow="@contract.Progress" aria-valuemin="0" aria-valuemax="100">@contract.Progress%</div>
                        </div>
                        <p class="card-text"><strong>Due Balance:</strong> @contract.DueBalance.ToString("C", crCulture)</p>
                    </div>
                    <div class="card-body">
                        <h4 class="card-title">Work Aspects</h4>
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Work Aspect</th>
                                    <th>Weight</th>
                                    <th style="width: 175px;">Current Progress</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (contract.WorkAspects != null && contract.WorkAspects.Any())
                                {
                                    @foreach (var tracking in contract.WorkAspects.Where(wa => !wa.IsExtra))
                                    {
                                        <tr>
                                            <td>@tracking.Name</td>
                                            <td>@tracking.Weight.ToString("F0")%</td>
                                            <td>
                                                <div class="progress">
                                                    <div class="progress-bar" role="progressbar" style="width:@tracking.Progress%" aria-valuenow="@tracking.Progress" aria-valuemin="0" aria-valuemax="100">@tracking.Progress%</div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted">No work aspects available.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        @if (contract.WorkAspects != null && contract.WorkAspects.Any(wa => wa.IsExtra))
                        {
                            <h5 class="mt-4">Additional Aspects</h5>
                            <table class="table table-striped table-hover">
                                <tbody>
                                    @foreach (var tracking in contract.WorkAspects.Where(wa => wa.IsExtra))
                                    {
                                        <tr class="table-warning">
                                            <td>@tracking.Name</td>
                                            <td>@tracking.Weight.ToString("F0")%</td>
                                            <td>
                                                <div class="progress">
                                                    <div class="progress-bar" role="progressbar" style="width:@tracking.Progress%" aria-valuenow="@tracking.Progress" aria-valuemin="0" aria-valuemax="100">@tracking.Progress%</div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>

                </div>
            </div>

            <div class="col-md-8">
                <div class="card mb-4">
                    <div class="card-body">
                        <h4 class="card-title">Revisions</h4>
                        @if (RevisionsList.Count == 0)
                        {
                            <p class="text-center text-muted">No revisions found.</p>
                        }
                        else
                        {
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Revision Number</th>
                                        <th>Date Created</th>
                                        <th>Remarks</th>
                                        <th>Amount Due</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var revision in RevisionsList)
                                    {
                                        <tr>
                                            <td>@revision.RevisionNumber</td>
                                            <td>@revision.DateCreated.ToShortDateString()</td>
                                            <td>@revision.Remarks</td>
                                            <td>@revision.AmountDue.ToString("C", crCulture)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        <div class="text-right mt-2">
                            <button class="btn btn-primary" @onclick="() => OnDetailsClick(ContractID)">View Revisions</button>
                        </div>
                    </div>
                    <div class="card-body">
                        <h4 class="card-title">Debits and Credits</h4>
                        <Transactions ContractID="@ContractID" />
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <h4 class="card-title">Summary</h4>
                @if (contract != null)
                {
                    <div class="row">
                        <div class="col-md-3">
                            <div class="card text-center">
                                <div class="card-body">
                                    <h5 class="card-title"><i class="fas fa-dollar-sign"></i> Contract Amount</h5>
                                    <p class="card-text">@contract.Amount.ToString("C", crCulture)</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center">
                                <div class="card-body">
                                    <h5 class="card-title"><i class="fas fa-exchange-alt"></i> Total from Transactions</h5>
                                    <p class="card-text">@TransactionTotal.ToString("C", crCulture)</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center">
                                <div class="card-body">
                                    <h5 class="card-title"><i class="fas fa-receipt"></i> Total from Revisions</h5>
                                    <p class="card-text">@contract.TotalPaid.ToString("C", crCulture)</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center">
                                <div class="card-body">
                                    <h5 class="card-title"><i class="fas fa-balance-scale"></i> Balance Amount</h5>
                                    <p class="card-text">@contract.DueBalance.ToString("C", crCulture)</p>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <p class="text-center text-muted">Contract details are not available.</p>
                }
            </div>
        </div>

        <div class="text-right mt-2">
            <button class="btn btn-primary" @onclick="() => OnEditClick(ContractID)">Edit Contract</button>
            <button class="btn btn-danger" @onclick="() => OnDeleteClick(ContractID)">Delete Contract</button>
        </div>

    }
</div>

@code {
    private Contract? contract;
    private decimal ContractAmountUSD;
    private string ContractAmountUSDString;
    private decimal TransactionTotal;
    private decimal ChangeOrdersTotal;

    CultureInfo crCulture = new CultureInfo("es-CR"); // Costa Rica culture

    [SupplyParameterFromQuery]
    private int ContractID { get; set; }

    private List<Revision> RevisionsList => contract?.Revisions.ToList() ?? new List<Revision>();

    private bool isLoading = false;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            using var context = DbFactory.CreateDbContext();
            contract = await context.Contracts
                .Include(c => c.Project)
                .Include(c => c.Subcontractor)
                .Include(c => c.WorkAspects)
                .Include(c => c.Revisions)
                .Include(c => c.Transactions)
                .Include(c => c.ChangeOrders) // Assuming ChangeOrders is a navigation property
                .FirstOrDefaultAsync(m => m.ContractID == ContractID);
        }
        catch (Exception ex)
        {
            // Log the error and show a user-friendly message
            errorMessage = "An error occurred while loading the contract details.";
        }
        finally
        {
            isLoading = false;
            Calculate();
        }
    }

    private void Calculate()
    {
        if (contract != null)
        {
            ContractAmountUSD = contract.Amount / 520;
            ContractAmountUSDString = ContractAmountUSD.ToString("C", new CultureInfo("en-US"));

            TransactionTotal = contract.Transactions.Sum(t => t.Amount);
            ChangeOrdersTotal = contract.ChangeOrders.Sum(co => co.Amount); // Calculate the sum of change orders
        }
    }

    private void OnDetailsClick(int contractID)
    {
        NavigationManager.NavigateTo($"/revisions?contractid={contractID}");
    }

    private void OnDeleteClick(int contractID)
    {
        NavigationManager.NavigateTo($"/contracts/delete?contractid={contractID}");
    }

    private void OnEditClick(int contractID)
    {
        NavigationManager.NavigateTo($"/contracts/edit?contractid={contractID}");
    }
}


<style>
    .table-warning {
        background-color: #ede505;
    }

    .container {
        max-width: 1500px;
    }

    .contract-header {
        background-color: #f5f5f5;
        padding: 15px;
        border-radius: 5px;
        margin-bottom: 20px;
    }

    .card {
        border-radius: 10px;
        background-color: #ffffff;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .card-body {
        padding: 2rem;
    }

    .card-title {
        font-weight: bold;
    }

    .progress-bar {
        background-color: #ff9100;
    }

    .progress {
        margin-bottom: 15px; /* Adjust the value as needed */
    }

    .table {
        background-color: white;
        border-radius: 5px;
        box-shadow: 0px 2px 8px rgba(0, 0, 0, 0.1);
    }

        .table th, .table td {
            text-align: center;
        }

    .table-striped tbody tr:nth-of-type(odd) {
        background-color: #f9f9f9;
    }

    .btn {
        font-size: 16px;
        padding: 10px 15px;
    }

    .btn-primary {
        background-color: #007bff;
        color: white;
    }

    .btn-danger {
        background-color: #dc3545;
        color: white;
    }

        .btn-primary:hover, .btn-danger:hover {
            opacity: 0.8;
        }

    .loading-text {
        color: #999;
        font-style: italic;
        text-align: center;
        margin: 20px 0;
    }

    .summary-section, .revisions-section {
        margin-top: 20px;
    }

    .text-right {
        text-align: right;
    }
</style>